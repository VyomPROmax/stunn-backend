# Stunn backend (Render/GitHub) environment variables
# Copy to .env locally (never commit real keys).

# --- Groq (used for /process-audio, /process-image, and as chat fallback when OPENAI_COMPAT_* is unset) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
STUNN_FALLBACK_MODEL=openai/gpt-oss-20b

# --- OpenAI-compatible endpoint (recommended for using OpenCode models per persona) ---
# Set these to the base URL + API key of a service that exposes /chat/completions
# and serves the OpenCode model IDs you choose.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Per-persona model mapping (OpenCode recommendations; override as needed)
MODEL_GENERAL=opencode/crouton-alpha-free
MODEL_CODER=opencode/iceman-free
MODEL_RESEARCH=opencode/beam-free
MODEL_CONCISE=opencode/deepseek-v4.1-flash-free

# --- Tuning ---
STUNN_MAX_TOKENS=2048
STUNN_TEMPERATURE=0.7
